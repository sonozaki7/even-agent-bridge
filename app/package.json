{
  "name": "even-agent-bridge",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test test/*.test.ts",
    "test:ui": "node scripts/check-ui.mjs",
    "pack": "npm run build:device && evenhub pack app.json dist-even --sdk-ver 0.0.16 -o agent-relay.ehpk",
    "simulator": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js",
    "dev:device": "vite --mode evenhub",
    "build:device": "tsc --noEmit && vite build --mode evenhub --outDir dist-even"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "22.15.3",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
